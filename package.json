{
  "name": "circuit-breakers-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive simulator of circuit breakers (Representation Rerouting & Harmfulness Probes) from Zou et al., 2024",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
